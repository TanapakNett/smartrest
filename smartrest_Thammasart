void handleSettings() {
  if (!(server.hasArg("age") && server.hasArg("hrRest") && server.hasArg("hi") && server.hasArg("lo"))) {
    server.send(400, "text/plain", "missing");
    return;
  }
  int age = server.arg("age").toInt();
  int hr  = server.arg("hrRest").toInt();
  int hi  = server.arg("hi").toInt();
  int lo  = server.arg("lo").toInt();

  bool ok = age >= 10 && age <= 100
         && hr >= 40 && hr <= 120
         && hi > hr + 20 && hi <= 220
         && lo >= 30 && lo <= 100 && lo < hr;
  if (!ok) {
    server.send(400, "text/plain", "invalid");
    return;
  }
  userAge = age; hrRest = hr; alertHi = hi; alertLo = lo;
  saveSettings();
  server.send(200, "text/plain", "OK");
}

void handleReset() {
  resetBeat();
  resetSpo2();
  resetRecovery();
  lastRecSec = 0;
  server.send(200, "text/plain", "OK");
}

void handleData() {
  String json;
  json.reserve(900);
  json = "{\"f\":";
  json += fingerOn ? 1 : 0;
  json += ",\"bpm\":";
  json += String(beatsPerMinute, 0);
  json += ",\"avg\":";
  json += String(rateCount >= 3 ? beatAvg : 0, 0);
  json += ",\"spo2\":";
  json += String(spo2Count >= 2 ? spo2Avg : 0, 1);
  json += ",\"rt\":";
  json += recoveryElapsed();
  json += ",\"lr\":";
  json += lastRecSec;
  json += ",\"ph\":";
  json += (int)phase;
  json += ",\"hr0\":";
  json += hrRest;
  json += ",\"hi\":";
  json += alertHi;
  json += ",\"lo\":";
  json += alertLo;
  json += ",\"age\":";
  json += userAge;
  json += ",\"s\":[";
  for (int i = 0; i < sampleCount; i++) {
    if (i) json += ",";
    json += sampleBuf[i];
  }
  json += "]}";
  sampleCount = 0;
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", json);
}

void startWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.setTxPower(WIFI_POWER_8_5dBm);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  unsigned long t0 = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t0 < 15000) {
    delay(500);
  }
  if (WiFi.status() != WL_CONNECTED) {
    WiFi.mode(WIFI_AP);
    WiFi.setTxPower(WIFI_POWER_8_5dBm);
    WiFi.softAP(AP_SSID, AP_PASS);
  }
}

void addSpo2Sample(long red, long ir) {
  sumRed += red;  sumRed2 += (double)red * red;
  sumIr  += ir;   sumIr2  += (double)ir * ir;
  if (++blockN < SPO2_BLOCK) return;

  double mr = sumRed / blockN, mi = sumIr / blockN;
  double vr = sumRed2 / blockN - mr * mr;
  double vi = sumIr2 / blockN - mi * mi;
  if (vr < 0) vr = 0;
  if (vi < 0) vi = 0;
  double acR = sqrt(vr), acI = sqrt(vi);

  sumRed = sumRed2 = sumIr = sumIr2 = 0;
  blockN = 0;

  if (mr <= 0 || mi <= 0 || acR <= 0 || acI <= 0) return;
  double R = (acR / mr) / (acI / mi);
  if (R < 0.2 || R > 1.5) return;

  double s = -45.060 * (R * R) + 30.354 * R + 94.845;
  if (s > 100) s = 100;
  if (s < 70) return;

  spo2Hist[spo2Spot++] = (float)s;
  spo2Spot %= SPO2_HIST;
  if (spo2Count < SPO2_HIST) spo2Count++;
  float sum = 0;
  for (byte i = 0; i < spo2Count; i++) sum += spo2Hist[i];
  spo2Avg = sum / spo2Count;
}

void handleSample(long red, long ir) {
  static unsigned long lostSince = 0;

  lastIR = ir;
  if (sampleCount >= BUF_MAX) {
    memmove(sampleBuf, sampleBuf + 1, (BUF_MAX - 1) * sizeof(long));
    sampleCount = BUF_MAX - 1;
  }
  sampleBuf[sampleCount++] = ir;

  if (ir < FINGER_THRESHOLD) {
    if (fingerOn) {
      if (lostSince == 0) lostSince = millis();
      if (millis() - lostSince > FINGER_LOST_MS) {
        fingerOn = false;
        lostSince = 0;
        resetBeat(); resetSpo2(); resetRecovery();
      }
    }
    return;
  }
  lostSince = 0;
  fingerOn = true;

  addSpo2Sample(red, ir);

  if (checkForBeat(ir)) {
    unsigned long now = millis();
    if (lastBeat != 0) {
      float bpm = 60000.0 / (now - lastBeat);
      bool inRange = bpm >= 45 && bpm <= 180;
      bool consistent = (rateCount < 3) || fabs(bpm - beatAvg) < 25;
      if (inRange && consistent) {
        beatsPerMinute = bpm;
        rates[rateSpot++] = bpm;
        rateSpot %= RATE_SIZE;
        if (rateCount < RATE_SIZE) rateCount++;
        float sum = 0;
        for (byte i = 0; i < rateCount; i++) sum += rates[i];
        beatAvg = sum / rateCount;

        if (rateCount >= 3) updatePhase(now, (int)(beatAvg + 0.5));
      }
    }
    lastBeat = now;
  }
}

void updateOled() {
  if (!oledOk) return;
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.print("Smart Rest - Recovery");

  if (!fingerOn) {
    display.setCursor(0, 20);
    display.print("Place Finger...");
    IPAddress ip = (WiFi.getMode() == WIFI_AP) ? WiFi.softAPIP() : WiFi.localIP();
    display.setCursor(0, 40);
    display.print(ip.toString());
  } else {
    display.setTextSize(2);
    display.setCursor(0, 16);
    int hr = 0;
    if (rateCount >= 3) {
      hr = (int)(beatAvg + 0.5);
      display.print(hr);
      display.print(" BPM");
    } else {
      display.print("-- BPM");
    }

    display.setTextSize(1);
    display.setCursor(0, 42);
    if (phase == PH_DONE) {
      display.print("RECOVERED ");
      display.print(recoverySec);
      display.print("s");
    } else if (phase == PH_RECOVERY) {
      display.print("Recovering ");
      display.print(recoveryElapsed());
      display.print("s");
    } else if (phase == PH_EXERCISE) {
      display.print("Exercise");
    } else {
      display.print("Measuring");
    }

    if (hr > alertHi) {
      display.setCursor(0, 54);
      display.print("!! REST NOW !!");
    }
  }
  display.display();
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  Wire.begin(SDA_PIN, SCL_PIN);

  oledOk = display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR);
  if (oledOk) {
    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    display.setTextSize(1);
    display.setCursor(0, 0);
    display.print("Starting...");
    display.display();
  }

  if (!particleSensor.begin(Wire, I2C_SPEED_STANDARD)) {
    Serial.println("MAX30102 not found. Check wiring.");
    if (oledOk) {
      display.clearDisplay();
      display.setCursor(0, 0);
      display.print("Sensor not found!");
      display.setCursor(0, 16);
      display.print("Check wiring");
      display.display();
    }
    while (1) delay(1000);
  }
  particleSensor.setup(LED_BRIGHTNESS, 4, 2, 400, 411, 4096);

  loadSettings();
  startWiFi();

  server.on("/", handleRoot);
  server.on("/data", handleData);
  server.on("/set", handleSettings);
  server.on("/reset", handleReset);
  server.begin();
}

void loop() {
  server.handleClient();
  particleSensor.check();
  while (particleSensor.available()) {
    long red = particleSensor.getFIFORed();
    long ir  = particleSensor.getFIFOIR();
    particleSensor.nextSample();
    handleSample(red, ir);
  }

  if (millis() - lastOled >= 500) {
    lastOled = millis();
    updateOled();
  }
  delay(5);
}
