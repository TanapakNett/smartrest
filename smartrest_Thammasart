}

void resetRecovery() {
  phase = PH_IDLE;
  peakHR = 0; minHR = 0;
  peakTime = 0; dropSince = 0; recoveryStartTime = 0;
  recoverySec = 0;
}

int recoveryElapsed() {
  if (phase == PH_RECOVERY) return (int)((millis() - recoveryStartTime) / 1000);
  if (phase == PH_DONE) return recoverySec;
  return 0;
}

void updatePhase(unsigned long now, int hr) {
  switch (phase) {
    case PH_IDLE:
      if (hr > hrRest + EXERCISE_MARGIN) {
        phase = PH_EXERCISE; peakHR = hr; peakTime = now; dropSince = 0;
      }
      break;

    case PH_EXERCISE:
      if (hr >= peakHR) {
        peakHR = hr; peakTime = now; dropSince = 0;
      } else if (hr <= peakHR - DROP_BPM) {
        if (dropSince == 0) {
          dropSince = now;
        } else if (now - dropSince >= DROP_HOLD_MS) {
          phase = PH_RECOVERY;
          recoveryStartTime = peakTime;
          minHR = hr;
        }
      } else {
        dropSince = 0;
      }
      break;

    case PH_RECOVERY:
      if (hr < minHR) minHR = hr;
      if (hr <= hrRest + RECOVER_MARGIN) {
        phase = PH_DONE;
        recoverySec = (int)((now - recoveryStartTime) / 1000);
        lastRecSec = recoverySec;
      } else if (hr >= minHR + RESUME_BPM) {
        phase = PH_EXERCISE; peakHR = hr; peakTime = now; dropSince = 0;
      }
      break;

    case PH_DONE:
      if (hr > hrRest + EXERCISE_MARGIN) {
        phase = PH_EXERCISE; peakHR = hr; peakTime = now; dropSince = 0; recoverySec = 0;
      }
      break;
  }
}

